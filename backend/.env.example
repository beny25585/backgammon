SECRET_KEY=your-generated-secret-key
DEBUG=False
ALLOWED_HOSTS=yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com
DATABASE_URL=postgres://username:password@localhost:5432/backgammon_db
REDIS_URL=redis://127.0.0.1:6379/0
GAMELINK_ENABLED=1
GAMELINK_TICKET_SECRETS=shared-ticket-secret-from-tournaments
GAMELINK_RESULT_SECRET=shared-result-secret-for-backgammon-to-tournaments
GAMELINK_TOURNAMENTS_URL=https://your-tournaments-backend-domain.com
GAMELINK_TOURNAMENTS_FRONTEND_URL=https://your-tournaments-frontend-domain.com
# Private Open Sage live worker (can use the analysis service for local development).
AI_SERVICE_URL=http://127.0.0.1:8006
# Must match ANALYSIS_API_TOKEN in the analysis service; never expose to the frontend.
ANALYSIS_API_TOKEN=
ANALYSIS_SERVICE_URL=http://127.0.0.1:8006
