# Copy to docker/production.env; do not put credentials in this file.
# Set a unique image tag for each reviewed release.
IMAGE_TAG=replace-with-reviewed-release
PUBLIC_HOST=38.247.146.17.nip.io
PUBLIC_ORIGIN=https://38.247.146.17.nip.io
CONFIG_DIR=/etc/backgammon-docker
TRANSFER_DIR=/home/administrator/backgammon-transfer
# Unused ports for validating APIs before the maintenance window.
# Change these to 8005 / 8006 / 8007 only during the final cutover.
GAME_API_PORT=18005
TOURNAMENTS_API_PORT=18006
ANALYSIS_API_PORT=18007
GAME_FRONTEND_PORT=18105
TOURNAMENTS_FRONTEND_PORT=18106
ADMIN_FRONTEND_PORT=18108
